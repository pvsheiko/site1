# Публичный HTTPS-адрес сайта, без завершающего слэша.
SITE_URL=
# Supabase → Project Settings → Data API → Project URL.
SUPABASE_URL=
# Supabase → Settings → API Keys → Secret key (sb_secret_...) или legacy service_role.
# Только сервер. Не добавлять префикс NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Токен собственного Telegram-бота от @BotFather. Только сервер.
TELEGRAM_BOT_TOKEN=
# Числовой ID личного чата либо группы. Сначала нажать Start у бота.
TELEGRAM_CHAT_ID=
# Для кнопок статуса: случайная строка из 32+ символов, только A-Z a-z 0-9 _ -.
TELEGRAM_WEBHOOK_SECRET=
# Только для группы: числовой ID человека, которому разрешено менять статусы.
TELEGRAM_ADMIN_USER_ID=
